<script>var SCRIPT = "\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = {\n      screen: 'welcome', prev: 'home',\n      food: 2, fish: ['peach', 'tang', 'peach', 'tang'], unlockIdx: 0,\n      decor: [], calm: false, calmUnlocked: false, feeding: false,\n      meal: null, mood: null, helped: [],\n      tech: 'breathe', toast: null, unlock: null,\n      invitee: null,\n      questions: ['Is it okay to have dessert when I eat out with friends?', 'What can I do when evenings feel hard?'],\n      draft: '',\n      share: { mood: true, journal: false, pool: true }\n    };\n    var p = props && props.preset;\n    var homeBase = { screen: 'home', fish: ['peach', 'tang', 'peach', 'tang', 'blush', 'moon'], unlockIdx: 2, decor: ['table'], calmUnlocked: true, food: 3 };\n    var presets = {\n      welcome: { screen: 'welcome' },\n      intro: { screen: 'intro' },\n      home: homeBase,\n      checkin: { screen: 'checkin', meal: 'Lunch', mood: 'okay', helped: ['Eating with someone', 'Music'] },\n      distress: { screen: 'checkin', meal: 'Dinner', mood: 'over' },\n      coping: { screen: 'coping', tech: 'breathe' },\n      unlock: Object.assign({}, homeBase, { unlock: { kind: 'jelly', color: '#E4EEFF', stripe: '#FFFFFF', kicker: 'NEW BREED UNLOCKED', title: 'Moon jelly', body: 'Practising a coping technique brought a new breed to your tide pool.' } }),\n      'break': { screen: 'break' },\n      moonlit: Object.assign({}, homeBase, { calm: true, decor: ['table', 'lantern', 'arch'], fish: ['peach', 'tang', 'peach', 'tang', 'blush', 'moon', 'sunny', 'mint'] }),\n      eat: { screen: 'eat', invitee: 'Jun' },\n      care: { screen: 'care' },\n      help: { screen: 'help', prev: 'home' }\n    };\n    if (p && presets[p]) { Object.assign(this.state, presets[p]); }\n  }\n\n  species() {\n    return {\n      peach: { name: 'Peach puff', color: '#FFB38A', stripe: '#FFF4EA', jelly: false },\n      tang: { name: 'Periwinkle tang', color: '#7F95E8', stripe: '#FFD66B', jelly: false },\n      blush: { name: 'Blush guppy', color: '#FF9CC8', stripe: '#FFF0F7', jelly: false },\n      moon: { name: 'Moon jelly', color: '#E4EEFF', stripe: '#FFFFFF', jelly: true },\n      sunny: { name: 'Sunny goby', color: '#FFD66B', stripe: '#FF9F6B', jelly: false },\n      mint: { name: 'Mint wrasse', color: '#8FE3C8', stripe: '#FFFFFF', jelly: false },\n      lilac: { name: 'Lilac jelly', color: '#E2C9FF', stripe: '#FFFFFF', jelly: true }\n    };\n  }\n\n  go(screen) {\n    var prev = this.state.screen;\n    this.setState({ screen: screen, prev: (screen === 'help') ? prev : this.state.prev });\n  }\n\n  showToast(msg) {\n    var self = this;\n    this.setState({ toast: msg });\n    clearTimeout(this._t);\n    this._t = setTimeout(function () { self.setState({ toast: null }); }, 2600);\n  }\n\n  componentWillUnmount() { clearTimeout(this._t); clearTimeout(this._f); }\n\n  chip(sel) {\n    return 'min-height: 44px; padding: 0 16px; border-radius: 999px; font-size: 14px; font-weight: 800; border: 1.5px solid ' +\n      (sel ? '#5068B5; background: #5068B5; color: #FFFFFF' : '#E6DAB4; background: #FFFFFF; color: #2F3A66');\n  }\n\n  renderVals() {\n    var s = this.state, self = this, sp = this.species();\n\n    var fishList = s.fish.map(function (id, i) {\n      var d = sp[id];\n      var scale = 0.85 + ((i * 7) % 5) * 0.09;\n      var dur = 15 + ((i * 5) % 9);\n      return {\n        name: d.name, color: d.color, stripe: d.stripe,\n        isJelly: d.jelly, isFish: !d.jelly,\n        cls: d.jelly ? 'drift' : 'swim',\n        top: (22 + ((i * 37) % 44)) + '%',\n        left: (8 + ((i * 53) % 170)) + 'px',\n        dur: (d.jelly ? dur + 8 : dur) + 's',\n        delay: '-' + ((i * 3.3) % 14).toFixed(1) + 's',\n        w: Math.round(58 * scale), h: Math.round(35 * scale)\n      };\n    });\n\n    var meals = ['Breakfast', 'Lunch', 'Dinner', 'Snack', 'Rather not say'];\n    var mealChips = meals.map(function (m) {\n      return { label: m, sel: s.meal === m, style: self.chip(s.meal === m), pick: function () { self.setState({ meal: m }); } };\n    });\n\n    var moodDefs = [\n      { id: 'calm', label: 'Calm', face: '#CDEFE0', mouth: 'M13 25 C 16 29, 24 29, 27 25' },\n      { id: 'okay', label: 'Okay', face: '#DCE6FB', mouth: 'M14 26 L 26 26' },\n      { id: 'hard', label: 'Hard', face: '#FFE9C7', mouth: 'M13 28 C 16 24, 24 24, 27 28' },\n      { id: 'over', label: 'Overwhelmed', face: '#FFD3E6', mouth: 'M14 27 C 17 24, 20 30, 23 26 C 25 24, 26 27, 27 26' }\n    ];\n    var moods = moodDefs.map(function (m) {\n      var sel = s.mood === m.id;\n      return {\n        label: m.label, face: m.face, mouth: m.mouth, sel: sel,\n        style: 'display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 2px; border-radius: 18px; color: #2F3A66; border: 2px solid ' + (sel ? '#5068B5; background: #EAF0FD' : 'transparent; background: #FFFFFF'),\n        pick: function () { self.setState({ mood: m.id }); }\n      };\n    });\n\n    var helpers = ['Eating with someone', 'Music', 'A plan I made', 'Breathing', 'Something cosy after', 'Nothing today \u2014 that\u2019s okay'];\n    var helpChips = helpers.map(function (h) {\n      var sel = s.helped.indexOf(h) >= 0;\n      return {\n        label: h, sel: sel, style: self.chip(sel),\n        pick: function () {\n          var next = sel ? s.helped.filter(function (x) { return x !== h; }) : s.helped.concat([h]);\n          self.setState({ helped: next });\n        }\n      };\n    });\n\n    var techDefs = [{ id: 'breathe', label: 'Breathe' }, { id: 'ground', label: '5-4-3-2-1' }, { id: 'kind', label: 'Kind words' }];\n    var techs = techDefs.map(function (t) {\n      return { label: t.label, sel: s.tech === t.id, style: self.chip(s.tech === t.id), pick: function () { self.setState({ tech: t.id }); } };\n    });\n\n    var friendDefs = [{ name: 'Aisha', bg: '#FFB3D6' }, { name: 'Jun', bg: '#B9CCF5' }, { name: 'Mum', bg: '#FFE08A' }];