     goIntro: function () { self.go('intro'); },\n      goHome: function () { self.go('home'); },\n      goCheckin: function () { self.setState({ mood: null, meal: null, helped: [] }); self.go('checkin'); },\n      goCoping: function () { self.go('coping'); },\n      goBreak: function () { self.go('break'); },\n      goEat: function () { self.go('eat'); },\n      goCare: function () { self.go('care'); },\n      goHelp: function () { self.go('help'); },\n      goBack: function () { self.setState({ screen: s.prev || 'home' }); },\n\n      waterBg: s.calm ? '#454A93' : '#9D9BEB',\n      sandColor: s.calm ? '#6E6FAE' : '#D9D2F5',\n      rockColor: s.calm ? '#8A8CC4' : '#EDE8FF',\n      showRays: !s.calm, calm: s.calm, calmUnlocked: s.calmUnlocked,\n      calmLabel: s.calm ? 'Daylight' : 'Moonlit',\n      toggleCalm: function () { self.setState({ calm: !s.calm }); },\n      fishList: fishList,\n      feeding: s.feeding,\n      feedLabel: s.food > 0 ? 'Feed fish \u00b7 ' + s.food + ' left' : 'Check in to earn food',\n      feed: function () {\n        if (s.food <= 0) { self.showToast('Fish food comes from meal check-ins.'); return; }\n        self.setState({ food: s.food - 1, feeding: true });\n        clearTimeout(self._f);\n        self._f = setTimeout(function () { self.setState({ feeding: false }); }, 2600);\n        self.showToast('Your fish are happily munching.');\n      },\n      hasTable: s.decor.indexOf('table') >= 0, hasLantern: s.decor.indexOf('lantern') >= 0, hasArch: s.decor.indexOf('arch') >= 0,\n      poolCount: s.fish.length + ' friends \u00b7 ' + decorCount + ' decorations',\n\n      mealChips: mealChips, moods: moods, helpChips: helpChips,\n      overwhelmed: s.mood === 'over',\n      saveDisabled: !saveOk,\n      saveStyle: 'min-height: 56px; border: 0; border-radius: 18px; font-family: \\'Fredoka\\', sans-serif; font-weight: 600; font-size: 19px; ' + (saveOk ? 'background: #5068B5; color: #FFFFFF' : 'background: #E6DAB4; color: #6F6A5A'),\n      saveCheckin: function () {\n        if (!s.mood) return;\n        self.setState({ food: s.food + 1, screen: 'home' });\n        self.showToast('Check-in saved \u00b7 +1 fish food');\n      },\n\n      techs: techs, techBreathe: s.tech === 'breathe', techGround: s.tech === 'ground', techKind: s.tech === 'kind',\n      finishCoping: function () {\n        var order = ['blush', 'moon', 'sunny', 'mint', 'lilac'];\n        var id = order[s.unlockIdx % order.length];\n        var isNew = s.unlockIdx < order.length;\n        var d = sp[id];\n        self.setState({\n          fish: s.fish.concat([id]), unlockIdx: s.unlockIdx + 1, screen: 'home',\n          unlock: { kind: d.jelly ? 'jelly' : 'fish', color: d.color, stripe: d.stripe,\n            kicker: isNew ? 'NEW BREED UNLOCKED' : 'A NEW FRIEND',\n            title: d.name, body: isNew ? 'Practising a coping technique brought a new breed to your tide pool.' : 'Another ' + d.name.toLowerCase() + ' swam in to keep the others company.' }\n        });\n      },\n\n      finishBreak: function () {\n        if (!s.calmUnlocked) {\n          self.setState({ calmUnlocked: true, calm: true, screen: 'home',\n            unlock: { kind: 'other', kicker: 'PEACEFUL SCENE UNLOCKED', title: 'Moonlit tide pool', body: 'Taking a break is looking after yourself. Switch to moonlight whenever you need a quieter pool.' } });\n        } else {\n          self.setState({ screen: 'home' });\n          self.showToast('Welcome back. Glad you took that pause.');\n        }\n      },\n\n      logShared: function () {\n        var all = [\n          { id: 'table', title: 'Shell picnic table', body: 'Sharing a meal brought a picnic table to your pool \u2014 room for everyone.' },\n          { id: 'lantern', title: 'Lantern coral', body: 'Good company lights things up. A glowing lantern coral now grows in your pool.' },\n          { id: 'arch', title: 'Friendship arch', body: 'An arch for your fish to swim through together, thanks to another shared meal.' }\n        ];\n        var next = all.filter(function (d) { return s.decor.indexOf(d.id) < 0; })[0];\n        if (!next) { self.showToast('Logged \u2014 sharing meals is worth celebrating.'); return; }\n        self.setState({ decor: s.decor.concat([next.id]), screen: 'home',\n          unlock: { kind: 'other', kicker: 'DECORATION UNLOCKED', title: next.title, body: next.body } });\n      },\n\n      friends: friends, hasInvitee: !!s.invitee, invitee: s.invitee || '',\n      sendInvite: function () { self.showToast('Invite sent to ' + s.invitee); self.setState({ invitee: null }); },\n      findSession: function () { self.showToast('In the full app, this opens SGH support activities.'); },\n\n      questions: s.questions.map(function (q) { return { text: q }; }),\n      draft: s.draft,\n      onDraft: function (e) { self.setState({ draft: e.target.value }); },\n      addQuestion: function () {\n        var t = (s.draft || '').trim();\n        if (!t) return;\n        self.setState({ questions: s.questions.concat([t]), draft: '' });\n        self.showToast('Added to your session questions');\n      },\n      shares: shares,\n\n      navHome: navStyle(s.screen === 'home'), navEat: navStyle(s.screen === 'eat'), navCare: navStyle(s.screen === 'care'),\n      navHomeCur: s.screen === 'home' ? 'page' : 'false', navEatCur: s.screen === 'eat' ? 'page' : 'false', navCareCur: s.screen === 'care' ? 'page' : 'false',\n\n      hasToast: !!s.toast, toast: s.toast || '',\n      hasUnlock: !!s.unlock,\n      unlockFish: u.kind === 'fish', unlockJelly: u.kind === 'jelly', unlockOther: u.kind === 'other',\n      unlockColor: u.color || '#FFB38A', unlockStripe: u.stripe || '#FFFFFF',\n      unlockKicker: u.kicker || '', unlockTitle: u.title || '', unlockBody: u.body || '',\n      closeUnlock: function () { self.setState({ unlock: null }); }\n    };\n  }\n}\n";
(function(){
  var app = document.getElementById('app');
  var inst;
  function DCLogic(props){ this.props = props || {}; this.state = {}; }
  DCLogic.prototype.setState = function(s){ Object.assign(this.state, typeof s === 'function' ? s(this.state) : s); schedule(); };
  DCLogic.prototype.forceUpdate = function(){ schedule(); };
  var Component = new Function('DCLogic', SCRIPT + '\nreturn Component;')(DCLogic);

  function look(path, scopes){
    path = path.trim();
    if (path === 'true') return true; if (path === 'false') return false;
    var parts = path.split('.');
    for (var i = 0; i < scopes.length; i++) { var sc = scopes[i];
      if (sc && Object.prototype.hasOwnProperty.call(sc, parts[0])) { var v = sc[parts[0]];
        for (var j = 1; j < parts.length; j++) v = v == null ? v : v[parts[j]]; return v; } }
    return undefined;
  }
  function interp(s, scopes){ return s.replace(/\{\{([^}]+)\}\}/g, function(_, p){ var v = look(p, scopes); return v == null ? '' : String(v); }); }
  var EVT = { onclick: 'click', onchange: 'input' };
  function build(node, scopes, parent){
    if (node.nodeType === 3) { parent.appendChild(document.createTextNode(interp(node.textContent, scopes))); return; }
    if (node.nodeType !== 1) return;
    var tag = node.localName;
    if (tag === 'sc-if') { if (look(node.getAttribute('value').replace(/[{}]/g, ''), scopes)) node.childNodes.forEach(function(c){ build(c, scopes, parent); }); return; }
    if (tag === 'sc-for') { var list = look(node.getAttribute('list').replace(/[{}]/g, ''), scopes) || []; var as = node.getAttribute('as');
      list.forEach(function(it, i){ var o = {}; o[as] = it; o.$index = i; var sc = [o].concat(scopes); node.childNodes.forEach(function(c){ build(c, sc, parent); }); }); return; }
    var el = node.cloneNode(false); el._h = {};
    Array.from(node.attributes).forEach(function(a){
      var n = a.name.toLowerCase();
      if (n.indexOf('hint-') === 0) { el.removeAttribute(a.name); return; }
      if (EVT[n]) { el.removeAttribute(a.name); var f = look(a.value.replace(/[{}]/g, ''), scopes); if (typeof f === 'function') el._h[EVT[n]] = f; return; }
      var whole = a.value.match(/^\{\{([^}]+)\}\}$/);
      if (whole) { var v = look(whole[1], scopes);
        if (n.indexOf('aria-') === 0) el.setAttribute(a.name, v === true ? 'true' : (v === false || v == null ? 'false' : String(v)));
        else if (v === false || v == null) el.removeAttribute(a.name);
        else el.setAttribute(a.name, v === true ? '' : String(v)); }
      else if (a.value.indexOf('{{') >= 0) el.setAttribute(a.name, interp(a.value, scopes));
    });
    node.childNodes.forEach(function(c){ build(c, scopes, el); });
    parent.appendChild(el);
  }
  function patch(a, b){
    // a: live node, b: freshly built node. Keep a where possible so animations and focus survive.
    if (a.nodeType !== b.nodeType || a.nodeName !== b.nodeName) { a.parentNode.replaceChild(b, a); return; }
    if (a.nodeType === 3) { if (a.textContent !== b.textContent) a.textContent = b.textContent; return; }
    Array.from(a.attributes).forEach(function(at){ if (!b.hasAttribute(at.name)) a.removeAttribute(at.name); });
    Array.from(b.attributes).forEach(function(at){ if (a.getAttribute(at.name) !== at.value) a.setAttribute(at.name, at.value); });
    a._h = b._h;
    if (a.localName === 'input' && document.activeElement !== a) { var v = b.getAttribute('value') || ''; if (a.value !== v) a.value = v; }
    if (a.localName === 'button') a.disabled = b.hasAttribute('disabled');
    var ak = Array.from(a.childNodes), bk = Array.from(b.childNodes);
    for (var i = 0; i < bk.length; i++) { if (i < ak.length) patch(ak[i], bk[i]); else a.appendChild(bk[i]); }
    for (var j = bk.length; j < ak.length; j++) a.removeChild(ak[j]);
  }
  var tplRoot = document.getElementById('tpl').content;
  var pending = false, lastScreen = null;
  function render(){
    pending = false;
    var frag = document.createElement('div');
    var vals = inst.renderVals();
    tplRoot.childNodes.forEach(function(c){ build(c, [vals], frag); });
    if (!app.firstChild) { while (frag.firstChild) app.appendChild(frag.firstChild); }
    else patch(app, Object.assign(frag, {}), true);
    if (inst.state.screen !== lastScreen) {
      lastScreen = inst.state.screen;
      app.querySelectorAll('[style*="overflow-y: auto"]').forEach(function(e){ e.scrollTop = 0; });
    }
  }
  function schedule(){ if (!pending) { pending = true; Promise.resolve().then(render); } }
  function dispatch(type, e){
    var n = e.target;
    while (n && n !== app) { if (n._h && n._h[type]) { if (n.disabled) return; n._h[type](e); return; } n = n.parentNode; }
  }
  app.addEventListener('click', function(e){ dispatch('click', e); });
  app.addEventListener('input', function(e){ dispatch('input', e); });
  app.addEventListener('keydown', function(e){
    if (e.key === 'Enter' && e.target.id === 'qinput') { var add = e.target.parentNode.querySelector('button'); if (add) add.click(); }
  });
  inst = new Component({});
  // patch() needs app's own attributes untouched: build into a clone shell
  var origPatch = patch;
  patch = function(a, b, isRoot){
    if (isRoot) { var ak = Array.from(a.childNodes), bk = Array.from(b.childNodes);
      for (var i = 0; i < bk.length; i++) { if (i < ak.length) origPatch(ak[i], bk[i]); else a.appendChild(bk[i]); }
      for (var j = bk.length; j < ak.length; j++) a.removeChild(ak[j]); return; }
    origPatch(a, b);
  };
  render();
})();
</script>

</body>
</html>
